{
  "name": "react-native-device-wallpaper",
  "version": "2.0.0",
  "description": "Set the device's wallpaper and lock screen with React Native (Android only)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "android",
    "!android/build",
    "!android/.gradle"
  ],
  "scripts": {
    "typecheck": "tsc"
  },
  "keywords": [
    "react-native",
    "android",
    "wallpaper",
    "device",
    "turbomodule"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/juanamd/react-native-device-wallpaper"
  },
  "author": "Juan Story",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.77.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.3",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "typescript": "^6.0.0"
  },
  "codegenConfig": {
    "name": "DeviceWallpaperSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "os.juanamd.devicewallpaper"
    }
  }
}
